# Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose variable substitution and local Spring Boot runs.

POSTGRES_PASSWORD=finpay_pass
REDIS_PASSWORD=
OPENAI_API_KEY=your_key_here
CONFIG_SERVER_PASSWORD=finpay_config_pass
JWT_SECRET=your_256_bit_secret_here
MONGO_URI=mongodb://localhost:27017/finpay

# Optional overrides for Spring Boot modules against this compose stack:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=finpay_user
# POSTGRES_PASSWORD=finpay_pass
# REDIS_HOST=localhost
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# MONGODB_URI=mongodb://localhost:27017/finpay_notifications
# EUREKA_URI=http://localhost:8761/eureka
# CONFIG_SERVER_URI=http://localhost:8888
# CONFIG_SERVER_USER=finpay
